# yarn.lock
# pnpm-lock.yaml

# Environment
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Secrets / Credentials ---
backend/credentials.json
backend/token.pickle
**/credentials.json
**/token.pickle
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*_key.json
**/*_secret.json

# --- OS / Editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Logs ---
backend/logs/

# --- Data repositories (large files) ---
backend/data/paper_repository/
backend/data/book_repository/
backend/data/paper_images/
!backend/data/paper_images/.gitkeep

# --- Frontend build ---
frontend/build/
frontend/dist/

# --- MongoDB Sync (NEW - scripts/) ---
# Backups are machine-specific, not synced
db-sync/backups/
# Temp files during import
db-sync/dumps/.import_temp/
# Dumps and status ARE synced via Syncthing
!db-sync/dumps/
!db-sync/dumps/.sync-status.json
!db-sync/dumps/dump_*.tar.gz

# --- MongoDB Sync (OLD - backend/, deprecated) ---
backend/mongodb_sync/backups/
!backend/mongodb_sync/latest/
!backend/mongodb_sync/last_export.json
# --- Service virtualenvs (platform-specific, rebuilt per machine) ---
backend/marker_service/marker_env/
backend/mineru_service/mineru_env/
