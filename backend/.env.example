# SmartTrendTracer Environment Variables
# =========================================
# This file documents all environment variables needed by SmartTrendTracer.
#
# IMPORTANT: These variables should be set in your GLOBAL ~/.env file
#            NOT in a project-local .env file.
#
# Both Linux and macOS machines should have identical values in ~/.env

# =========================================
# LLM API Keys
# =========================================
# All LLM providers are optional - configure only what you use

# OpenAI (GPT-4, GPT-4o-mini, etc.)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (Claude 3.5 Sonnet, etc.)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google (Gemini 1.5 Pro, etc.)
GOOGLE_API_KEY=your_google_api_key_here

# xAI (Grok)
GROK_API_KEY=your_grok_api_key_here

# =========================================
# Twitter/X API
# =========================================
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# =========================================
# MongoDB Configuration
# =========================================
# Local MongoDB instances (different on each machine)
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=smarttrendtracer

# Optional: MongoDB authentication
# MONGODB_USERNAME=your_username
# MONGODB_PASSWORD=your_password

# Optional: Replica set (for production)
# MONGODB_REPLICA_SET=rs0

# =========================================
# External PDF Processing Services
# =========================================
# These services run locally or remotely

# Marker PDF processing service
MARKER_SERVICE_URL=http://localhost:8002

# MinerU PDF processing service
MINERU_SERVICE_URL=http://localhost:8003

# GROBID citation extraction (HuggingFace hosted)
GROBID_SERVICE_URL=https://kermitt2-grobid.hf.space

# =========================================
# Gmail API (for Substack collection)
# =========================================
# Gmail API credentials are stored in credentials.json file
# No environment variables needed, but you need:
# - credentials.json in backend/ directory
# - token.pickle generated during first authentication

# =========================================
# Reddit API (for Reddit collection)
# =========================================
# REDDIT_CLIENT_ID=your_reddit_client_id
# REDDIT_CLIENT_SECRET=your_reddit_client_secret

# =========================================
# Application Settings
# =========================================
# Environment mode (development, production, staging)
ENVIRONMENT=development

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# API server host and port
HOST=0.0.0.0
PORT=8000

# =========================================
# Optional: Ollama (Local LLM)
# =========================================
# OLLAMA_BASE_URL=http://localhost:11434

# =========================================
# Optional: Rate Limiting
# =========================================
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS_PER_MINUTE=60

# =========================================
# Optional: Vector Store Configuration
# =========================================
# EMBEDDING_MODEL=text-embedding-ada-002
# EMBEDDING_DIMENSION=1536

# =========================================
# Setup Instructions
# =========================================
#
# 1. Copy these variables to your global ~/.env file
#    (NOT to a project-local .env file)
#
# 2. Replace placeholder values with your actual keys
#
# 3. Ensure both Linux and macOS machines have identical ~/.env
#
# 4. Restart the backend server to pick up changes:
#    cd backend
#    uvicorn app.main:app --reload
#
# 5. Verify environment variables are loaded:
#    python -c "import os; print(os.getenv('OPENAI_API_KEY', 'NOT SET'))"
#
# =========================================
# Security Notes
# =========================================
#
# - NEVER commit API keys to git
# - Keep ~/.env file permissions restricted: chmod 600 ~/.env
# - Use different keys for development/production
# - Rotate keys regularly
# - Monitor API usage for suspicious activity
